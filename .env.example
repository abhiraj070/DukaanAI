# DukaanAI Environment Configuration
# Copy this file to .env (or backend/.env and frontend/.env.local) and adjust values

# Application Environment
APP_ENV=development
APP_SECRET_KEY=replace-with-a-secure-secret-key-at-least-32-chars
BACKEND_HOST=127.0.0.1
BACKEND_PORT=8000
FRONTEND_ORIGIN=http://localhost:3000

# Next.js Frontend Configuration
NEXT_PUBLIC_API_URL=http://127.0.0.1:8000

# Database Configuration (Neon PostgreSQL target)
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/dukaanai

# External AI Provider Keys (for Phase 10 & 11)
GEMINI_API_KEY=
OPENAI_API_KEY=

# Storage Configuration (Supabase Storage / local fallback)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
MAX_UPLOAD_MB=20

# Localization Defaults
DEFAULT_CURRENCY=INR
DEFAULT_TIMEZONE=Asia/Kolkata
